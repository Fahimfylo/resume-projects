# ===============================================
# API Configuration
# ===============================================

# API endpoint URL - where the backend server is hosted
VITE_API_URL=https://api.prospct.com

# WebSocket connection URL (if using real-time features)
VITE_WS_URL=wss://api.prospct.com

# ===============================================
# OAuth Configuration
# ===============================================

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# LinkedIn OAuth Client ID
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id

# ===============================================
# Feature Flags
# ===============================================

# Enable/disable payment features
VITE_ENABLE_PAYMENTS=true

# Enable/disable subscription features
VITE_ENABLE_SUBSCRIPTIONS=true

# Enable/disable affiliate program
VITE_ENABLE_AFFILIATE=false

# ===============================================
# Analytics & Monitoring
# ===============================================

# Google Analytics ID
VITE_GOOGLE_ANALYTICS_ID=G-XXXXX

# Sentry DSN for error tracking
VITE_SENTRY_DSN=https://your_sentry_dsn

# ===============================================
# Application Configuration
# ===============================================

# Application name
VITE_APP_NAME=Prospct

# Application version (update from package.json)
VITE_APP_VERSION=1.0.0

# Support email
VITE_SUPPORT_EMAIL=support@prospct.com

# ===============================================
# Development Settings
# ===============================================

# Enable debug logging in browser console
VITE_DEBUG=false

# API request timeout (milliseconds)
VITE_REQUEST_TIMEOUT=30000

# ===============================================
# Security
# ===============================================

# Disable in production
VITE_ALLOW_INSECURE_HTTP=false

# Enable/disable HTTPS enforcement
VITE_ENFORCE_HTTPS=true

# ===============================================
# Notes
# ===============================================

# 1. These variables are embedded in the JavaScript bundle
#    Only use for NON-SENSITIVE information
#
# 2. Sensitive API keys should stay on backend only
#    Never put secret keys here!
#
# 3. Vite only exposes variables starting with VITE_
#    Variables starting with other prefixes are ignored
#
# 4. Access in React code:
#    import.meta.env.VITE_API_URL
#    // OR
#    process.env.VITE_API_URL (older method)
#
# 5. Example usage in React:
#    const API_URL = import.meta.env.VITE_API_URL || 'http://localhost:5000'
