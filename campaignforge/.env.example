# ── Frontend (root .env.local, read by Vite at build time) ──
# Base URL of the API. For local dev use http://localhost:4000/api/v1
# For production set to https://<your-app>.vercel.app/api/v1 (same-domain hosting).
# If set to a bare origin (no /api/v1), "/api/v1" is appended automatically.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ── Server (server/.env — gitignored, set in Vercel dashboard for deploys) ──
APP_URL=http://localhost:3000

# Gemini AI (required: GEMINI_API_KEY)
GEMINI_API_KEY=
# Primary model (default gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
# Auto-used when the primary model is out of quota (default gemini-2.0-flash-lite)
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# SMTP (temporarily disabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@campaignforge.com
