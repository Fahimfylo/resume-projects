# --- Server ---
# Port the Express API listens on.
PORT=4000

# MongoDB connection string. Replace with your own Atlas/local URI.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/archflow"

# URL where the Vite frontend is served (used for CORS defaults).
APP_URL="http://localhost:3000"

# Gemini AI API key. Optional — the analysis pipeline degrades gracefully
# (deterministic-only summaries/insights) when this is empty.
GEMINI_API_KEY=""

# --- Auth ---
# JWT access + rotating refresh tokens, both delivered as httpOnly cookies.
# The access token is short-lived; the refresh token is rotated on every use.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Set to your real domain in production (leave empty for localhost).
COOKIE_DOMAIN=""

# Local disk storage for uploaded codebases + avatars.
UPLOAD_DIR="./storage"
MAX_UPLOAD_SIZE_MB=200
# Set to true to keep extracted source files after analysis completes.
KEEP_SOURCE_FILES=false

# Storage driver for uploaded codebases/avatars.
# "local"  → files on disk under UPLOAD_DIR (development default).
# "mongo"  → files in MongoDB (required on Vercel — serverless functions have
#            an ephemeral filesystem). Set to "mongo" in production.
STORAGE_ADAPTER="local"
